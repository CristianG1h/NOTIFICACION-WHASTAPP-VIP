# =========================
# VIP NOTIFICACIONES - RENDER
# =========================
HOST=0.0.0.0
PORT=3210
DATA_DIR=.data

# Seguridad interna. Ambos son 64 caracteres hexadecimales.
API_TOKEN=
DATA_KEY=

# WhatsApp Web
WHATSAPP_MODE=web

# Fuente de citas
SOURCE_MODE=vip-api
VIP_API_BASE_URL=https://vip-teleconsulta-api.onrender.com
# Debe ser EXACTAMENTE el mismo valor de NOTIFICATIONS_READ_TOKEN
# configurado en el Render del backend VIP Teleconsulta.
VIP_API_TOKEN=

# Médico principal: formato internacional, SOLO números, sin + ni espacios.
# Colombia: 57 + número celular. Ejemplo: 573001234567
DOCTOR_PHONE=
DOCTOR_ID=medico_principal
# true = todas las citas notifican a DOCTOR_PHONE (recomendado si solo hay un médico)
DOCTOR_FORCE_DEFAULT=true

# Opcional pero recomendado en Render Free.
# Primero conecta WhatsApp en /admin/whatsapp, carga los grupos y copia el ID
# del grupo (termina en @g.us) aquí para que no se pierda al reiniciar.
CONTROL_GROUP_ID=

# Panel que recibe el médico
DOCTOR_PANEL_URL=https://medico.vip-mediconecta.app/panel-medico
MEDICONNECTA_BASE_URL=https://vip-mediconecta.app

# Dejar desactivado mientras no necesites consultar campos extra directamente
# desde MediConecta. Las citas principales vienen por VIP_API_BASE_URL.
MEDICONNECTA_LOOKUP=false
MEDICONNECTA_AUTH_MODE=bearer
MEDICONNECTA_TOKEN=

REMINDER_MINUTES=15
POLL_SECONDS=15

# Avanzado: configuración JSON adicional. Normalmente NO hace falta si usas
# DOCTOR_PHONE y CONTROL_GROUP_ID.
ROUTING_JSON=

# Opcional: ruta a Chrome si fuera necesario.
CHROME_PATH=
