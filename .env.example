# =========================
# VIP NOTIFICACIONES - BAILEYS + MONGODB
# =========================
HOST=0.0.0.0
PORT=3210
DATA_DIR=.data

# Seguridad interna. Ambos son 64 caracteres hexadecimales.
API_TOKEN=
DATA_KEY=

# WhatsApp sin Chrome/Puppeteer
WHATSAPP_MODE=baileys

# Persistencia de WhatsApp, médicos, confirmaciones y registro de envíos.
# NO subas la URI real ni la contraseña a GitHub.
MONGODB_URI=
BAILEYS_SESSION_ID=vip-notificaciones-principal
# Opcional. Si la URI ya contiene /vip_notificaciones, puede quedar vacío.
MONGODB_DB=

# Fuente de citas
SOURCE_MODE=vip-api
VIP_API_BASE_URL=https://vip-teleconsulta-api.onrender.com
VIP_API_TOKEN=

# Opcional: migración del médico anterior. Los administradores pueden escribir MEDICO.
# Administradores: 573102210461 y 573212340504 (src/doctors.js).
# Al guardar desde WhatsApp se usa el directorio y ya no se necesita DOCTOR_ID.
DOCTOR_PHONE=
DOCTOR_ID=medico_principal
DOCTOR_FORCE_DEFAULT=true

# Puede quedar vacío para la primera vinculación; se elige en /admin/whatsapp.
CONTROL_GROUP_ID=

DOCTOR_PANEL_URL=https://medico.vip-mediconecta.app/panel-medico
MEDICONNECTA_BASE_URL=https://vip-mediconecta.app
MEDICONNECTA_LOOKUP=true
MEDICONNECTA_AUTH_MODE=public
MEDICONNECTA_TOKEN=
# Mapeo del pago manual de MediConecta (por defecto: pagado)
MEDICONNECTA_PAYMENT_PATH=pagado

REMINDER_MINUTES=15
POLL_SECONDS=15
ROUTING_JSON=
